{
  "schemaVersion": 1,
  "pack": "windows",
  "updated": "2026-07-28",
  "rules": [
    {
      "id": "browser-caches",
      "kind": "location",
      "title": "Browser caches",
      "description": "Chrome / Edge / Firefox caches — pages reload a bit slower once",
      "category": "cache",
      "confidence": "high",
      "paths": [
        "{localAppData}/Google/Chrome/User Data/Default/Cache",
        "{localAppData}/Microsoft/Edge/User Data/Default/Cache",
        "{localAppData}/Mozilla/Firefox/Profiles"
      ]
    },
    {
      "id": "dev-caches",
      "kind": "location",
      "title": "Developer caches",
      "description": "Package-manager and tool caches — rebuilt when next used",
      "category": "cache",
      "confidence": "high",
      "paths": [
        "{localAppData}/npm-cache",
        "{localAppData}/Yarn/Cache",
        "{localAppData}/pip/cache",
        "{localAppData}/NuGet/Cache",
        "{home}/.m2/repository",
        "{home}/.cargo/registry",
        "{localAppData}/Temp"
      ]
    },
    {
      "id": "windows-old",
      "kind": "location",
      "title": "Previous Windows installation",
      "description": "Windows.old holds your last Windows version so you can roll back. Windows deletes it on its own about ten days after an upgrade, and it is owned by the system — use Storage settings rather than the Recycle Bin.",
      "category": "junk",
      "confidence": "high",
      "action": "advice",
      "adviceCommand": "Settings ▸ System ▸ Storage ▸ Temporary files",
      "paths": ["{systemDrive}/Windows.old"]
    },
    {
      "id": "windows-update-cache",
      "kind": "location",
      "title": "Windows Update cache",
      "description": "Downloaded update packages Windows keeps after installing them. They regenerate, but the folder is system-owned, so let Windows clear it.",
      "category": "cache",
      "confidence": "high",
      "action": "advice",
      "adviceCommand": "Settings ▸ System ▸ Storage ▸ Temporary files",
      "paths": ["{windir}/SoftwareDistribution/Download"]
    },
    {
      "id": "wsl-docker-vhdx",
      "kind": "location",
      "title": "Docker / WSL2 virtual disk",
      "description": "A WSL2 virtual disk never shrinks by itself, even after you delete things inside it. The file IS your Linux or Docker data — reclaim the space from inside, then compact the disk.",
      "category": "cache",
      "confidence": "high",
      "action": "advice",
      "adviceCommand": "docker system prune -a --volumes, then wsl --shutdown",
      "paths": [
        "{localAppData}/Docker/wsl/data",
        "{localAppData}/Docker/wsl/disk",
        "{localAppData}/Packages/CanonicalGroupLimited.Ubuntu_79rhkp1fndgsc/LocalState"
      ]
    },
    {
      "id": "pkgcache-npm",
      "kind": "package-cache",
      "title": "npm cache",
      "description": "Downloaded npm tarballs and npx scratch installs — npm refetches what it needs",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "npm",
      "paths": ["{localAppData}/npm-cache", "{home}/.npm/_cacache", "{home}/.npm/_npx"],
      "clearCommand": "npm cache clean --force"
    },
    {
      "id": "pkgcache-yarn",
      "kind": "package-cache",
      "title": "Yarn cache",
      "description": "Yarn's global package cache",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "yarn",
      "paths": ["{localAppData}/Yarn/Cache", "{home}/.yarn/berry/cache"],
      "clearCommand": "yarn cache clean"
    },
    {
      "id": "pkgcache-pnpm",
      "kind": "package-cache",
      "title": "pnpm store",
      "description": "pnpm's content-addressed package store",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "pnpm",
      "paths": ["{localAppData}/pnpm/store", "{localAppData}/pnpm-store"],
      "clearCommand": "pnpm store prune"
    },
    {
      "id": "pkgcache-pip",
      "kind": "package-cache",
      "title": "pip cache",
      "description": "Downloaded and built Python wheels",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "python",
      "paths": ["{localAppData}/pip/cache"],
      "clearCommand": "pip cache purge"
    },
    {
      "id": "pkgcache-cargo",
      "kind": "package-cache",
      "title": "Cargo registry",
      "description": "Downloaded crate sources and their .crate archives",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "cargo",
      "paths": ["{home}/.cargo/registry"],
      "clearCommand": "delete %USERPROFILE%\\.cargo\\registry"
    },
    {
      "id": "pkgcache-maven",
      "kind": "package-cache",
      "title": "Maven repository",
      "description": "Every jar Maven has ever downloaded — refetched on the next build",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "maven",
      "paths": ["{home}/.m2/repository"],
      "clearCommand": "mvn dependency:purge-local-repository"
    },
    {
      "id": "pkgcache-gradle",
      "kind": "package-cache",
      "title": "Gradle caches",
      "description": "Gradle's dependency and build caches",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "gradle",
      "paths": ["{home}/.gradle/caches"],
      "clearCommand": "gradle --stop, then delete %USERPROFILE%\\.gradle\\caches"
    },
    {
      "id": "pkgcache-nuget",
      "kind": "package-cache",
      "title": "NuGet cache",
      "description": "Downloaded NuGet packages and HTTP cache",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "nuget",
      "paths": ["{localAppData}/NuGet/Cache", "{localAppData}/NuGet/v3-cache", "{home}/.nuget/packages"],
      "clearCommand": "dotnet nuget locals all --clear"
    },
    {
      "id": "pkgcache-chocolatey",
      "kind": "package-cache",
      "title": "Chocolatey cache",
      "description": "Installer packages Chocolatey keeps after installing",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "chocolatey",
      "paths": ["{localAppData}/Temp/chocolatey", "{systemDrive}/ProgramData/chocolatey/lib-bad"],
      "clearCommand": "choco cache remove --expired"
    },
    {
      "id": "pkgcache-winget",
      "kind": "package-cache",
      "title": "winget cache",
      "description": "Installers winget downloaded, kept after the install finished",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "winget",
      "paths": ["{localAppData}/Packages/Microsoft.DesktopAppInstaller_8wekyb3d8bbwe/LocalState"],
      "clearCommand": "Settings ▸ Apps ▸ Installed apps ▸ App Installer ▸ Advanced options ▸ Reset"
    }
  ]
}
