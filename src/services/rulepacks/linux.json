{
  "schemaVersion": 1,
  "pack": "linux",
  "updated": "2026-07-28",
  "rules": [
    {
      "id": "browser-caches",
      "kind": "location",
      "title": "Browser caches",
      "description": "Chrome / Firefox caches — pages reload a bit slower once",
      "category": "cache",
      "confidence": "high",
      "paths": [
        "{home}/.cache/google-chrome",
        "{home}/.cache/chromium",
        "{home}/.cache/mozilla"
      ]
    },
    {
      "id": "dev-caches",
      "kind": "location",
      "title": "Developer caches",
      "description": "Package-manager and tool caches — rebuilt when next used",
      "category": "cache",
      "confidence": "high",
      "paths": [
        "{home}/.npm/_cacache",
        "{home}/.cache/yarn",
        "{home}/.cache/pip",
        "{home}/.m2/repository",
        "{home}/.cargo/registry",
        "{home}/.gradle/caches"
      ]
    },
    {
      "id": "package-manager-caches",
      "kind": "location",
      "title": "Package manager caches",
      "description": "Downloaded .deb / package files kept after installing. They are owned by root, so the package manager should clear them rather than the Trash.",
      "category": "cache",
      "confidence": "high",
      "action": "advice",
      "adviceCommand": "sudo apt-get clean   ·   sudo paccache -r   ·   sudo dnf clean all",
      "paths": [
        "/var/cache/apt/archives",
        "/var/cache/pacman/pkg",
        "/var/cache/dnf",
        "/var/cache/zypp/packages"
      ]
    },
    {
      "id": "journal-logs",
      "kind": "location",
      "title": "systemd journal logs",
      "description": "The system log. It is capped by configuration rather than deleted by hand — vacuuming it is the supported way, and keeps journalctl working.",
      "category": "cache",
      "confidence": "high",
      "action": "advice",
      "adviceCommand": "sudo journalctl --vacuum-size=200M",
      "paths": ["/var/log/journal"]
    },
    {
      "id": "flatpak-snap-runtimes",
      "kind": "location",
      "title": "Flatpak and Snap runtimes",
      "description": "Old runtime versions and retained Snap revisions. Removing the directory by hand breaks the apps that share those runtimes — the package tools free the same space safely.",
      "category": "cache",
      "confidence": "high",
      "action": "advice",
      "adviceCommand": "flatpak uninstall --unused   ·   sudo snap set system refresh.retain=2",
      "paths": [
        "/var/lib/flatpak/runtime",
        "{home}/.local/share/flatpak/runtime",
        "/var/lib/snapd/snaps"
      ]
    },
    {
      "id": "pkgcache-npm",
      "kind": "package-cache",
      "title": "npm cache",
      "description": "Downloaded npm tarballs and npx scratch installs — npm refetches what it needs",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "npm",
      "paths": ["{home}/.npm/_cacache", "{home}/.npm/_npx"],
      "clearCommand": "npm cache clean --force"
    },
    {
      "id": "pkgcache-yarn",
      "kind": "package-cache",
      "title": "Yarn cache",
      "description": "Yarn's global package cache",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "yarn",
      "paths": ["{home}/.cache/yarn", "{home}/.yarn/berry/cache"],
      "clearCommand": "yarn cache clean"
    },
    {
      "id": "pkgcache-pnpm",
      "kind": "package-cache",
      "title": "pnpm store",
      "description": "pnpm's content-addressed package store",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "pnpm",
      "paths": ["{home}/.local/share/pnpm/store", "{home}/.pnpm-store"],
      "clearCommand": "pnpm store prune"
    },
    {
      "id": "pkgcache-pip",
      "kind": "package-cache",
      "title": "pip cache",
      "description": "Downloaded and built Python wheels",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "python",
      "paths": ["{home}/.cache/pip"],
      "clearCommand": "pip cache purge"
    },
    {
      "id": "pkgcache-cargo",
      "kind": "package-cache",
      "title": "Cargo registry",
      "description": "Downloaded crate sources and their .crate archives",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "cargo",
      "paths": ["{home}/.cargo/registry"],
      "clearCommand": "rm -rf ~/.cargo/registry"
    },
    {
      "id": "pkgcache-maven",
      "kind": "package-cache",
      "title": "Maven repository",
      "description": "Every jar Maven has ever downloaded — refetched on the next build",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "maven",
      "paths": ["{home}/.m2/repository"],
      "clearCommand": "mvn dependency:purge-local-repository"
    },
    {
      "id": "pkgcache-gradle",
      "kind": "package-cache",
      "title": "Gradle caches",
      "description": "Gradle's dependency and build caches",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "gradle",
      "paths": ["{home}/.gradle/caches"],
      "clearCommand": "gradle --stop, then rm -rf ~/.gradle/caches"
    },
    {
      "id": "pkgcache-apt",
      "kind": "package-cache",
      "title": "apt / dpkg archives",
      "description": "Downloaded .deb packages kept after installing. Root owns them, so let apt clear them.",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "apt",
      "action": "advice",
      "adviceCommand": "sudo apt-get clean",
      "paths": ["/var/cache/apt/archives"],
      "clearCommand": "sudo apt-get clean"
    },
    {
      "id": "pkgcache-linuxbrew",
      "kind": "package-cache",
      "title": "Homebrew cache",
      "description": "Downloaded bottles and source archives kept after installing",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "homebrew",
      "paths": ["{home}/.cache/Homebrew"],
      "clearCommand": "brew cleanup -s"
    }
  ]
}
