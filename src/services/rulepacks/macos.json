{
  "schemaVersion": 1,
  "pack": "macos",
  "updated": "2026-08-30",
  "rules": [
    {
      "id": "browser-caches",
      "kind": "location",
      "title": "Browser caches",
      "description": "Chrome / Safari / Firefox caches — pages reload a bit slower once",
      "category": "cache",
      "confidence": "high",
      "paths": [
        "{home}/Library/Caches/Google/Chrome",
        "{home}/Library/Caches/com.apple.Safari",
        "{home}/Library/Caches/Firefox",
        "{home}/Library/Caches/Chromium",
        "{home}/Library/Caches/company.thebrowser.Browser"
      ]
    },
    {
      "id": "dev-caches",
      "kind": "location",
      "title": "Developer caches",
      "description": "Xcode and package-manager caches — rebuilt when next used",
      "category": "cache",
      "confidence": "high",
      "paths": [
        "{home}/Library/Developer/Xcode/DerivedData",
        "{home}/Library/Developer/Xcode/iOS DeviceSupport",
        "{home}/Library/Developer/CoreSimulator/Caches",
        "{home}/Library/Caches/Homebrew",
        "{home}/Library/Caches/pip",
        "{home}/Library/Caches/Yarn",
        "{home}/.npm/_cacache",
        "{home}/.m2/repository",
        "{home}/.cargo/registry",
        "{home}/.gradle/caches"
      ]
    },
    {
      "id": "xcode-archives",
      "kind": "location",
      "title": "Xcode archives",
      "description": "Every build you have ever archived. They are also the only way to symbolicate crash reports from those releases, so TreeMap will not offer to trash them — delete the ones you no longer support from Xcode's Organizer.",
      "category": "cache",
      "confidence": "high",
      "action": "advice",
      "adviceCommand": "Xcode ▸ Window ▸ Organizer ▸ Archives",
      "paths": [
        "{home}/Library/Developer/Xcode/Archives"
      ]
    },
    {
      "id": "docker-vm-image",
      "kind": "location",
      "title": "Docker Desktop disk image",
      "description": "Docker's virtual disk only ever grows, and deleting the file destroys every image, container and volume on this machine. Reclaim the space from inside Docker instead.",
      "category": "cache",
      "confidence": "high",
      "action": "advice",
      "adviceCommand": "docker system prune -a --volumes",
      "paths": [
        "{home}/Library/Containers/com.docker.docker/Data/vms/0/data",
        "{home}/Library/Containers/com.docker.docker/Data/vms/0"
      ]
    },
    {
      "id": "pkgcache-npm",
      "kind": "package-cache",
      "title": "npm cache",
      "description": "Downloaded npm tarballs and npx scratch installs — npm refetches what it needs",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "npm",
      "paths": [
        "{home}/.npm/_cacache",
        "{home}/.npm/_npx"
      ],
      "clearCommand": "npm cache clean --force"
    },
    {
      "id": "pkgcache-yarn",
      "kind": "package-cache",
      "title": "Yarn cache",
      "description": "Yarn's global package cache",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "yarn",
      "paths": [
        "{home}/Library/Caches/Yarn",
        "{home}/.cache/yarn",
        "{home}/.yarn/berry/cache"
      ],
      "clearCommand": "yarn cache clean"
    },
    {
      "id": "pkgcache-pnpm",
      "kind": "package-cache",
      "title": "pnpm store",
      "description": "pnpm's content-addressed package store",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "pnpm",
      "paths": [
        "{home}/Library/pnpm/store",
        "{home}/.pnpm-store",
        "{home}/.local/share/pnpm/store"
      ],
      "clearCommand": "pnpm store prune"
    },
    {
      "id": "pkgcache-pip",
      "kind": "package-cache",
      "title": "pip cache",
      "description": "Downloaded and built Python wheels",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "python",
      "paths": [
        "{home}/Library/Caches/pip",
        "{home}/.cache/pip"
      ],
      "clearCommand": "pip cache purge"
    },
    {
      "id": "pkgcache-cargo",
      "kind": "package-cache",
      "title": "Cargo registry",
      "description": "Downloaded crate sources and their .crate archives",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "cargo",
      "paths": [
        "{home}/.cargo/registry"
      ],
      "clearCommand": "cargo cache -a  (or delete ~/.cargo/registry)"
    },
    {
      "id": "pkgcache-maven",
      "kind": "package-cache",
      "title": "Maven repository",
      "description": "Every jar Maven has ever downloaded — refetched on the next build",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "maven",
      "paths": [
        "{home}/.m2/repository"
      ],
      "clearCommand": "mvn dependency:purge-local-repository"
    },
    {
      "id": "pkgcache-gradle",
      "kind": "package-cache",
      "title": "Gradle caches",
      "description": "Gradle's dependency and build caches",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "gradle",
      "paths": [
        "{home}/.gradle/caches"
      ],
      "clearCommand": "gradle --stop, then delete ~/.gradle/caches"
    },
    {
      "id": "pkgcache-homebrew",
      "kind": "package-cache",
      "title": "Homebrew cache",
      "description": "Downloaded bottles and source archives kept after installing",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "homebrew",
      "paths": [
        "{home}/Library/Caches/Homebrew"
      ],
      "clearCommand": "brew cleanup -s"
    },
    {
      "id": "media-photos-derivatives",
      "kind": "location",
      "title": "Photos thumbnails & previews",
      "description": "Regenerated thumbnails and preview renders inside the system Photos library — never your photos. Photos rebuilds them on next open; expect a slow first launch while it does. Quit Photos before touching anything inside its library. Not offered for deletion from here: the Media Libraries view (GET /api/media) makes the gated offer after checking the owning app is not holding the library.",
      "category": "regenerable",
      "confidence": "high",
      "action": "advice",
      "adviceCommand": "Quit Photos first — it rebuilds these automatically the next time it opens",
      "paths": [
        "{home}/Pictures/Photos Library.photoslibrary/resources/derivatives"
      ]
    },
    {
      "id": "media-fcp-render-files",
      "kind": "project-directory",
      "title": "Final Cut / iMovie render files",
      "description": "Rendered and transcoded media inside a Final Cut Pro or iMovie library event. Re-created on demand — playback stutters until each clip re-renders. Original media is never touched. Not offered for deletion from here: the Media Libraries view (GET /api/media) makes the gated offer after checking the owning app is not holding the library.",
      "category": "regenerable",
      "confidence": "high",
      "action": "advice",
      "adviceCommand": "Final Cut Pro ▸ File ▸ Delete Generated Library Files",
      "names": [
        "render files",
        "transcoded media"
      ],
      "requiresSibling": [
        "original media",
        "currentversion.fcpevent"
      ],
      "restoreCommand": "Re-rendered automatically when the project is next played or exported"
    },
    {
      "id": "pkgcache-cocoapods",
      "kind": "package-cache",
      "title": "CocoaPods cache",
      "description": "Downloaded pod sources and specs",
      "category": "cache",
      "confidence": "high",
      "ecosystem": "cocoapods",
      "paths": [
        "{home}/Library/Caches/CocoaPods"
      ],
      "clearCommand": "pod cache clean --all"
    }
  ]
}