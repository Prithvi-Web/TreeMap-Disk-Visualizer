{
  "schemaVersion": 1,
  "pack": "common",
  "updated": "2026-07-28",
  "rules": [
    {
      "id": "regen-node-modules",
      "kind": "project-directory",
      "title": "node_modules",
      "description": "JavaScript dependencies — restore any time",
      "category": "regenerable",
      "confidence": "high",
      "ecosystem": "npm",
      "names": ["node_modules"],
      "ownerManifest": ["package.json"],
      "evidence": [".package-lock.json", ".bin", ".modules.yaml", ".yarn-integrity", ".pnpm"],
      "restoreCommand": "npm install"
    },
    {
      "id": "regen-python-venv",
      "kind": "project-directory",
      "title": "Python virtualenv",
      "description": "Virtual environment — recreate from the project manifest",
      "category": "regenerable",
      "confidence": "high",
      "ecosystem": "python",
      "names": [".venv", "venv", "env"],
      "requiresSibling": ["requirements.txt", "pyproject.toml", "pipfile", "setup.py", "setup.cfg", ".python-version"],
      "evidence": ["pyvenv.cfg"],
      "restoreCommand": "pip install -r requirements.txt"
    },
    {
      "id": "regen-pycache",
      "kind": "project-directory",
      "title": "Python bytecode cache",
      "description": "__pycache__ — Python regenerates it automatically",
      "category": "regenerable",
      "confidence": "high",
      "names": ["__pycache__"],
      "restoreCommand": "automatic on next run"
    },
    {
      "id": "regen-rust-target",
      "kind": "project-directory",
      "title": "Rust build target",
      "description": "Cargo build output and fetched crates",
      "category": "regenerable",
      "confidence": "high",
      "ecosystem": "cargo",
      "names": ["target"],
      "requiresSibling": ["cargo.toml"],
      "evidence": ["cachedir.tag", ".rustc_info.json", ".rustdoc_fingerprint.json"],
      "restoreCommand": "cargo build"
    },
    {
      "id": "regen-maven-target",
      "kind": "project-directory",
      "title": "Maven build target",
      "description": "Maven build output",
      "category": "regenerable",
      "confidence": "high",
      "ecosystem": "maven",
      "names": ["target"],
      "requiresSibling": ["pom.xml"],
      "evidence": ["maven-status", "maven-archiver", "surefire-reports"],
      "restoreCommand": "mvn package"
    },
    {
      "id": "regen-gradle-build",
      "kind": "project-directory",
      "title": "Gradle build output",
      "description": "Compiled output — rebuilt by the next Gradle build",
      "category": "regenerable",
      "confidence": "high",
      "ecosystem": "gradle",
      "names": ["build"],
      "requiresSibling": ["build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts"],
      "evidence": ["tmp", "libs", "intermediates", "classes"],
      "restoreCommand": "gradle build"
    },
    {
      "id": "regen-cocoapods",
      "kind": "project-directory",
      "title": "CocoaPods",
      "description": "Installed pods — restore with pod install",
      "category": "regenerable",
      "confidence": "high",
      "ecosystem": "cocoapods",
      "names": ["pods"],
      "requiresSibling": ["podfile"],
      "evidence": ["manifest.lock", "pods.xcodeproj", "target support files"],
      "restoreCommand": "pod install"
    },
    {
      "id": "regen-web-build",
      "kind": "project-directory",
      "title": "Web framework build",
      "description": "Framework build output — rebuilt by the next build",
      "category": "regenerable",
      "confidence": "high",
      "ecosystem": "npm",
      "names": [".next", ".nuxt", ".output", ".svelte-kit", ".angular"],
      "ownerManifest": ["package.json"],
      "evidence": ["static", "server", "cache", "build-manifest.json", "prerender-manifest.json"],
      "restoreCommand": "npm run build"
    },
    {
      "id": "regen-web-build",
      "kind": "project-directory",
      "title": "Web framework build",
      "description": "Framework build output — rebuilt by the next build",
      "category": "regenerable",
      "confidence": "high",
      "ecosystem": "npm",
      "names": ["dist"],
      "requiresSibling": ["package.json", "next.config.*", "nuxt.config.*", "vite.config.*", "svelte.config.*", "angular.json"],
      "ownerManifest": ["package.json"],
      "evidence": ["static", "server", "cache", "build-manifest.json", "prerender-manifest.json"],
      "restoreCommand": "npm run build"
    },

    {
      "id": "build-output",
      "kind": "directory",
      "title": "Build output",
      "description": "Compiled output folders — regenerated by the next build",
      "category": "regenerable",
      "confidence": "medium",
      "names": ["dist", "target", "build"]
    },
    {
      "id": "tool-caches",
      "kind": "directory",
      "title": "Tool caches",
      "description": "Caches left by dev tools — rebuilt automatically when needed",
      "category": "cache",
      "confidence": "high",
      "names": [
        ".pytest_cache", ".mypy_cache", ".ruff_cache", ".gradle", ".turbo",
        ".parcel-cache", ".eslintcache", "coverage", ".venv", ".tox"
      ]
    },

    {
      "id": "os-junk",
      "kind": "file",
      "title": "OS junk files",
      "description": "Hidden metadata files the OS recreates on demand",
      "category": "junk",
      "confidence": "high",
      "names": [".ds_store", "thumbs.db", "desktop.ini"]
    },

    {
      "id": "old-downloads",
      "kind": "stale-files",
      "title": "Old Downloads",
      "description": "Files in Downloads untouched for 90+ days",
      "category": "junk",
      "confidence": "medium",
      "withinPath": "{home}/Downloads",
      "olderThanDays": 90,
      "minSizeBytes": 1048576
    }
  ]
}
