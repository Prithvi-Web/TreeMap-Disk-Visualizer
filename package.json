{
  "name": "treemap",
  "version": "4.1.3",
  "description": "See exactly what's eating your disk \u2014 a desktop app for macOS and Windows, web mode on Linux, and an MCP server so AI agents can use it too",
  "author": {
    "name": "Prithvi Vinay",
    "url": "https://github.com/Prithvi-Web"
  },
  "homepage": "https://github.com/Prithvi-Web/TreeMap-Disk-Visualizer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prithvi-Web/TreeMap-Disk-Visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/Prithvi-Web/TreeMap-Disk-Visualizer/issues"
  },
  "keywords": [
    "disk-space",
    "disk-usage",
    "treemap",
    "duplicate-finder",
    "electron",
    "mcp",
    "macos",
    "windows"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:ui": "node scripts/build-ui.js",
    "build": "node scripts/build-ui.js && tsc && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "test": "node scripts/run-tests.js",
    "typecheck": "tsc --noEmit",
    "capabilities:report": "tsx scripts/report-capabilities.ts",
    "bench:v4": "tsx scripts/bench-v4.ts",
    "mcp": "tsx src/mcp/index.ts",
    "app": "npm run build && electron .",
    "dist": "npm run build && npm run fetch:gdu && electron-builder",
    "dist:mac": "npm run build && npm run fetch:gdu && electron-builder --mac",
    "dist:win": "npm run build && npm run fetch:gdu && electron-builder --win",
    "dist:linux": "npm run build && npm run fetch:gdu && electron-builder --linux",
    "fetch:gdu": "node scripts/fetchGdu.js",
    "fetch:gdu:dev": "node scripts/fetchGdu.js --dev",
    "dist:portable-mac": "npm run build && npm run fetch:gdu && electron-builder --mac zip --config.artifactName=\"TreeMap-Portable-${version}-${arch}.${ext}\" && node scripts/mark-portable.js",
    "dist:portable-win": "npm run build && npm run fetch:gdu && electron-builder --win portable --config.artifactName=\"TreeMap-Portable-${version}.${ext}\"",
    "dist:portable-linux": "npm run build && npm run fetch:gdu && electron-builder --linux AppImage --config.artifactName=\"TreeMap-Portable-${version}-${arch}.${ext}\" && node scripts/mark-portable.js",
    "fleet:acceptance": "npm run build && node scripts/fleet-acceptance.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "pdfmake": "^0.2.23",
    "sharp": "^0.35.2",
    "zod": "^4.4.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "@types/pdfmake": "^0.3.3",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.prithviweb.treemap",
    "productName": "TreeMap",
    "afterPack": "scripts/afterPack.js",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/@foliojs-fork/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Prithvi-Web",
      "repo": "TreeMap-Disk-Visualizer"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "public.folder"
            ],
            "LSHandlerRank": "Alternate"
          }
        ]
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "build/gdu/${os}-${arch}",
        "to": "gdu",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/gdu/LICENSE.md",
        "to": "gdu/LICENSE.md"
      }
    ]
  }
}
