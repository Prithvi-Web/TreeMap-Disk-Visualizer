node_modules/
dist/
release/
*.log
.DS_Store

# Bundled gdu binary — fetched at build time by scripts/fetchGdu.js, never committed
/gdu/

# gdu binaries staged for bundling — fetched by scripts/fetchGdu.js, never committed.
# The licence files beside them are committed, so every package carries them:
# gdu's LICENSE.md, and the notices of the Go modules inside gdu with the module
# list they were written from (scripts/gdu-notices.js).
/build/gdu/*
!/build/gdu/LICENSE.md
!/build/gdu/THIRD_PARTY_NOTICES.txt
!/build/gdu/gdu-modules.json

# VS Code extension: compiled output and the packaged bundle — never committed
/vscode-extension/out/
/vscode-extension/*.vsix
.gstack/

# Benchmark run outputs — every run writes one; only bench/baselines/ is committed
/bench/results/

# The native core: built by npm run build:native or by CI, never committed
/native/prebuilt/
/native/treemap-core/target/
